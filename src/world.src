// world.src — the Emberdeep dungeon: rooms, exits, monsters, items, npcs.
// Flat parallel arrays (no nested slices in MFL).

var RN = []string{"Entrance Hall", "Dark Corridor", "Armory", "Shrine of Embers", "Goblin Den", "Flooded Cellar", "Crypt", "Old Bridge", "Treasure Vault", "Dragon's Lair"}

var RD = []string{
	"Torchlight fades behind you. The dungeon breathes cold, wet air.",
	"A narrow corridor; scratch marks line the walls. Something small skitters.",
	"Racks of rusted weapons sag under their own weight. One sword still gleams.",
	"A warm shrine. An old hermit tends a small flame and pretends not to see you.",
	"Bones and filth. A goblin snarls over a heap of stolen things.",
	"Ankle-deep black water. Something glints beneath the surface.",
	"Stone sarcophagi in rows. A skeleton drags itself upright as you enter.",
	"A rope bridge over a black chasm. A hooded merchant waits at the midpoint.",
	"An iron vault, heavy and cold. The lock hangs open.",
	"Heat. Gold heaped in dunes. A dragon sleeps on the summit of its hoard.",
}

var RL = []string{
	"Carved over the lintel, half worn away: HALL OF THE EMBER-THANE. LET THE FIRE SERVE, NEVER RULE.",
	"The scratch marks are letters. Miners' last words: VAEL CAME WITH THE THAW. THE THANE SEALED THE DOOR ABOVE US.",
	"A smith's mark on the racks: the Ember-Thane's own forge armed this hall once.",
	"The shrine flame is old dwarven emberfire — it has burned without fuel for a hundred years.",
	"The stolen heap is miners' gear: lanterns, wedding rings, a child's whistle. The goblin found them deeper in.",
	"The glint underwater is a drowned lantern, still lit — emberfire does not drown.",
	"The newest sarcophagus reads: HERE LIES THE LAST EMBER-THANE. HE BOUGHT THE SEAL WITH HIS HOUSE.",
	"A plaque on the rope anchor: THE THANE'S TITHE PAID FOR THIS BRIDGE. WALK LIGHTLY, THE DEEP REMEMBERS.",
	"Inside the vault door, scratched from within: THE SWORD WAS NEVER THE POINT. THE AMULET IS THE SEAL.",
	"The hoard is not treasure to Vaelmorax. It is a grave she is building for the mountain.",
}

